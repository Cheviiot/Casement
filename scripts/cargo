#!/bin/sh
# The project's cargo: the official rustup toolchain from ~/.local/share/toolchains.
# Distribution Rust (Fedora) links its std against a newer glibc than ALT has, so the
# binary would not start on the host; official builds target glibc 2.17.
toolchains="$HOME/.local/share/toolchains"
export RUSTUP_HOME="${RUSTUP_HOME:-$toolchains/rustup}"
export CARGO_HOME="${CARGO_HOME:-$toolchains/cargo-home}"
export PATH="$CARGO_HOME/bin:$PATH"
exec "$CARGO_HOME/bin/cargo" "$@"
