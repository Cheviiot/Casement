#!/bin/sh
# Builds the ALT p11 RPM of the release build (cargo build --release) in a throwaway
# Debian 13 container, as CI does (packaging/alt/build.sh). Output: dist/.
set -e
cd "$(dirname "$0")/.."
podman run --rm --cpus 4 -v "$PWD:/src" -w /src -e REL="${REL:-alt1}" \
    docker.io/library/debian:13 sh packaging/alt/build.sh
