#!/bin/sh
# Builds Libadwaita for Windows (Fedora has no mingw64-libadwaita) from the official GNOME
# release, checked against GNOME's published SHA-256, into PREFIX for package-windows.
# Needs mingw64-gtk4 mingw64-appstream mingw64-fribidi sassc meson ninja-build curl.
#   scripts/build-libadwaita-mingw [PREFIX]
set -e
version=1.8.3
series=${version%.*}
prefix=${1:-$HOME/.local/share/toolchains/mingw-libadwaita}
work="${XDG_CACHE_HOME:-$HOME/.cache}/casement-build/libadwaita-$version"
rm -rf "$work" && mkdir -p "$work" && cd "$work"
curl -sSfLO "https://download.gnome.org/sources/libadwaita/$series/libadwaita-$version.tar.xz"
curl -sSfL "https://download.gnome.org/sources/libadwaita/$series/libadwaita-$version.sha256sum" -o sums
grep "libadwaita-$version.tar.xz" sums | sha256sum -c -
tar xf "libadwaita-$version.tar.xz"
cd "libadwaita-$version"
meson setup build-w64 --cross-file /usr/share/mingw/toolchain-mingw64.meson \
    --prefix="$prefix" --buildtype=release -Dintrospection=disabled -Dvapi=false \
    -Dgtk_doc=false -Dtests=false -Dexamples=false
ninja -C build-w64 -j "${JOBS:-$(nproc)}"
ninja -C build-w64 install
cd / && rm -rf "$work"
echo "Libadwaita $version for Windows in $prefix"
