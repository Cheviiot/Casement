#!/bin/sh
# Builds the Fedora RPM of the release build (cargo build --release) in a throwaway
# Fedora 44 container. Output: dist/. CI runs packaging/fedora/build.sh directly.
set -e
cd "$(dirname "$0")/.."
podman run --rm --cpus 4 -v "$PWD:/src" -w /src -e REL="${REL:-1}" \
    registry.fedoraproject.org/fedora:44 sh packaging/fedora/build.sh
